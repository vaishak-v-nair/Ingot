# Reference corpora and benchmarks. Reproducible with the fetch scripts, and some carry
# licences that forbid redistribution, so they are never committed.
data/

# Generated scan output
reports/

# Fetched pretraining corpora, if anyone points --out inside the repo. The scripts
# default to ../corpora so gigabytes never land in a working tree, but a default is not
# a guarantee and this file is the guarantee.
corpora/

# Published bundle, rebuilt by prepack on every publish
dist/

# Build artifacts from scripts/build-web.ts and build-registry-page.ts
web/ingot.js
web/registry.html
# Note the trailing /*, not /. Excluding the directory itself makes the negation below
# unreachable: git never descends into an ignored directory to reconsider a file.
web/indexes/*
# HumanEval (70 KB) and GSM8K (350 KB) are one-way hashes with no benchmark text, so they
# ship: `npx ingot-scan contaminate --index gsm8k` works with nothing else downloaded, and
# test/sample-corpus.test.ts can assert the front page still matches. MMLU is 5.35 MB and
# stays a download.
!web/indexes/humaneval.idx.bin.gz
!web/indexes/gsm8k.idx.bin.gz

# Node
node_modules/
*.log

# Secrets. This repository is public, and a key committed here is a key published:
# rewriting history does not unpublish it. Ingot itself needs no credential — it runs
# offline with no API key — so anything matching these is an accident by definition.
.env
.env.*
*.pem
*.key

# OS
Thumbs.db
.DS_Store

# results/ is deliberately NOT ignored. The measured numbers are the product.
.gstack/
